# ---------------------------------------------------------------------------
# Secrets (SEC-1). These lines come first deliberately: nothing below this
# block is allowed to be the reason a credential reaches the history.
# The OANDA personal access token carries trading authority, not read-only
# data access -- see docs/DATA_SOURCES.md section 3.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
.next/
# Generated by Next.js on build/dev. It references paths inside .next/, which
# is itself ignored. Verified that typecheck passes with and without it.
apps/web/next-env.d.ts
*.tsbuildinfo

# Test and coverage output
coverage/
.vitest/
test-results/
playwright-report/
blob-report/
.playwright/

# Caches
.cache/
.turbo/
.eslintcache

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# Editor and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# Local scratch
tmp/
scratch/

# Machine-readable CI test report (obligation 18). Generated only when CI=1.
apps/worker/integration-report.json

# Database dumps (T0.10 L3). From Phase 6 these contain journal entries and
# trade notes - the most personal artefact the project holds. Never committed.
backups/

# Raw provider payloads captured by the market-data adapter (T1.4).
#
# Written before parsing so a bar rejected downstream is still recoverable —
# see packages/providers/src/marketdata/capture.ts. A full 6.6-year backfill
# writes tens of megabytes here, and it is raw market data rather than source,
# so it is kept locally and never committed.
var/captures/
