# -----------------------------------------------------------------------------
# KaratX - environment configuration template
#
# Copy to `.env` and fill in real values:
#
#     cp .env.example .env
#
# `.env` is git-ignored (SEC-1). This file is committed and must therefore
# never contain a real credential - only placeholders.
#
# Every variable below is validated by a Zod schema at process start
# (packages/config). A missing or malformed value fails the boot with a named
# ConfigValidationError listing every problem at once, rather than surfacing
# later as a confusing runtime failure (SEC-2).
# -----------------------------------------------------------------------------


# Which environment this process is running in.
#   Required: no - defaults to `development`
#   Values:   development | test | production
NODE_ENV=development


# Logging verbosity. Consumed by the Pino logger added in T0.5.
#   Required: no - defaults to `info`
#   Values:   trace | debug | info | warn | error | fatal
LOG_LEVEL=info


# PostgreSQL connection string.
#   Required: YES - there is no default and the process will not start without it
#   Format:   postgres:// or postgresql:// URL
#
#   SECRET IN DEPLOYED ENVIRONMENTS. This value contains a password. It is
#   wrapped in `Secret<T>` by packages/config so it cannot be printed by
#   accident, and validation errors never echo it. Never paste a real value
#   into a commit message, an issue, or a chat message.
#
#   The value below is NOT a secret and is safe to use as-is. It matches the
#   local Docker database defined in docker-compose.yml, which is bound to
#   127.0.0.1 and reachable only from this machine. Copying this file
#   unchanged gives you a working local setup.
#
#   In production, Railway generates its own DATABASE_URL and injects it into
#   the service directly. It is never copied by hand and never stored here.
#
#   Start the local database first:  pnpm db:up
DATABASE_URL=postgres://karatx:karatx_local_dev@127.0.0.1:5432/karatx


# Disable Next.js anonymous telemetry.
#   Required: no - but set it
#   Values:   1
#
#   Next.js collects anonymous build-time usage data by default. The risk is
#   low - it is not market data, credentials or code - but a private,
#   single-user tool should not phone home by default, and declining costs one
#   variable.
#
#   Set here rather than via `next telemetry disable`, which writes
#   machine-global state that a fresh clone or a new CI runner would silently
#   not have. T0.9 must set this in the CI environment too.
NEXT_TELEMETRY_DISABLED=1


# Twelve Data API key — the market-data provider chosen by ADR-008.
#   Required: NO at boot, YES for the backfill and feed jobs
#   Format:   an opaque key string
#
#   SECRET. Wrapped in `Secret<T>` by packages/config and registered in
#   SECRET_VARS, so it cannot be printed by accident and never appears in a
#   validation error. Get one from https://twelvedata.com — the free tier is
#   what ADR-008 evaluated and chose.
#
#   OPTIONAL HERE ON PURPOSE. CI has no key and must not need one: unit tests
#   run against recorded fixtures under test/fixtures/providers/ and never
#   reach the network. Making this required would fail every CI boot to
#   protect one job that CI does not run.
#
#   The jobs that need it check at START and refuse by name, rather than
#   discovering it missing on the first request — a five-minute backfill that
#   dies on request one is the same failure, moved later and made harder to
#   read.
#
#   IT IS SENT AS A HEADER, NEVER A QUERY PARAMETER (ADR-008). A key in a URL
#   reaches proxy logs, referrer headers and echoed error bodies.
TWELVEDATA_API_KEY=
