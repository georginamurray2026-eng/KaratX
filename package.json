{
  "name": "karatx",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "XAU/USD Command Centre - personal market-intelligence and setup-alerting system. Never places trades.",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm --filter @karatx/web build",
    "typecheck": "pnpm -r --no-bail typecheck && pnpm typecheck:iac && pnpm typecheck:tooling",
    "test": "pnpm -r --no-bail test",
    "test:integration": "pnpm -r --no-bail test:integration",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "db:reset": "docker compose down -v && docker compose up -d --wait postgres",
    "db:generate": "pnpm --filter @karatx/db db:generate",
    "db:migrate": "pnpm --filter @karatx/db db:migrate",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "db:drill": "node scripts/db-drill.mjs",
    "rollback:check": "node scripts/rollback-preflight.mjs",
    "typecheck:iac": "tsc --noEmit -p tsconfig.iac.json",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.tooling.json",
    "first-contact": "pnpm --filter @karatx/worker first-contact",
    "timezone-test": "pnpm --filter @karatx/worker timezone-test",
    "forming-bar-test": "pnpm --filter @karatx/worker forming-bar-test",
    "parity-fetch": "pnpm --filter @karatx/worker parity-fetch",
    "backfill": "pnpm --filter @karatx/worker backfill"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "railway": "^3.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
