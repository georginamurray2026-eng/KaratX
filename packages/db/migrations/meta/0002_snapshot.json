          "value": "\"candles\".\"low\" <= \"candles\".\"open\" AND \"candles\".\"low\" <= \"candles\".\"close\""
        },
        "candles_spread_check": {
          "name": "candles_spread_check",
          "value": "\"candles\".\"bid\" IS NULL OR \"candles\".\"ask\" IS NULL OR \"candles\".\"ask\" >= \"candles\".\"bid\""
        }
      },
