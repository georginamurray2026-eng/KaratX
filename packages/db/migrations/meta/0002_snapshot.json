        },
        "candles_positive_check": {
          "name": "candles_positive_check",
          "value": "\"candles\".\"open\" > 0 AND \"candles\".\"high\" > 0 AND \"candles\".\"low\" > 0 AND \"candles\".\"close\" > 0"
