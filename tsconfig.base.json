{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    // T0.1 acceptance criteria. `noUncheckedIndexedAccess` is not optional
    // here: candle arrays are indexed constantly and this is the setting that
    // catches the off-by-one class of bug that would otherwise produce
    // silently wrong indicator values (ARCHITECTURE-AND-STACK.md section D).
    "strict": true,
    "noUncheckedIndexedAccess": true,

    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,

    // No ambient type packages by default. Each package opts in to what it
    // needs, so `packages/core` cannot even name `process`, `fetch` or a Node
    // builtin at the type level - a compile-time barrier reinforcing F.3
    // invariant 1, underneath the ESLint boundary added in T0.2.
    "types": [],

    "skipLibCheck": true,
    "noEmit": true,
    "sourceMap": true
  }
}
